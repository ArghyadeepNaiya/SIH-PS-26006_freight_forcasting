__pycache__/
*.py[cod]
ml-service/venv/
ml-service/models/*.joblib
.pytest_cache/

# Node
node_modules/
web/dist/
npm-debug.log*

# Editor and OS
.DS_Store
*.swp
.idea/
.vscode/
